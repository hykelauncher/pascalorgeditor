# Optional environment variables

# Dev server port (default: 3002, set in .env.defaults)
# PORT=3002

# The address people use to reach this editor. Read per request; set it when
# Pascal is hosted outside localhost (Mint sign-in and agent links use it).
# PASCAL_PUBLIC_URL=https://pascal.example.com

# Self-hosting: the one password that unlocks this editor. Required on any host
# that is not loopback. See SETUP.md, "Self-hosting".
# PASCAL_ADMIN_PASSWORD=change-me

# Optional bearer token for agents and scripts calling /api/scenes.
# PASCAL_SCENE_API_TOKEN=change-me-too

# In-editor AI assistant (the Assistant tab). Set a key for any of these
# providers; the tab's model picker lists every provider that has one, plus
# the models of a local Ollama (https://ollama.com) when it is running.
# AI_GATEWAY_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional: the default model, as <provider>:<model>
# (providers: gateway, anthropic, openai, google, ollama).
# PASCAL_ASSISTANT_MODEL=google:auto
# Optional: more models for the picker, comma separated.
# PASCAL_ASSISTANT_MODELS=openai:gpt-5.4-mini,ollama:qwen3:8b
